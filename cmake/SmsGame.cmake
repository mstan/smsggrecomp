include_guard(GLOBAL)

# The game owns game.toml and generated artifacts; this framework owns every
# build input and generation step shared by SMS/GG hosts.
function(sms_add_game TARGET)
    set(_engine "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    set(_config "${CMAKE_CURRENT_SOURCE_DIR}/game.toml")
    file(READ "${_config}" _text)
    string(REGEX MATCH "output_prefix[ \t]*=[ \t]*\"([A-Za-z_][A-Za-z_0-9]*)\"" _match "${_text}")
    set(_prefix "${CMAKE_MATCH_1}")
    if(NOT _prefix)
        message(FATAL_ERROR "game.toml requires a C-identifier output_prefix")
    endif()
    string(REGEX MATCH "rom[ \t]*=[ \t]*\"([^\"]+)\"" _match "${_text}")
    set(SMSGG_ROM "${CMAKE_CURRENT_SOURCE_DIR}/${CMAKE_MATCH_1}" CACHE FILEPATH "Owned cartridge ROM")
    set(SMSGG_ROM_${_prefix} "${SMSGG_ROM}" CACHE FILEPATH "Original cartridge for ${_prefix}")
    set(SMSGG_ROM "${SMSGG_ROM_${_prefix}}")
    option(SMSGG_REGENERATE "Regenerate native code from the verified ROM" ON)
    option(SMSGG_ENABLE_SDL "Build the interactive SDL2 host" ON)
    option(SMSGG_ENABLE_GPU "Enable faithful GPU internal resolution" ON)
    option(SMSGG_NATIVE_EXECUTION "Use qualified native CPU and PSG jobs" ON)
    option(SMSGG_REFERENCE_VDP "Use the scalar reference VDP" OFF)
    set(SMSGG_OPTIMIZATION "O2" CACHE STRING "Native compiler optimization")
    set_property(CACHE SMSGG_OPTIMIZATION PROPERTY STRINGS O1 O2 O3)
    if(NOT SMSGG_OPTIMIZATION MATCHES "^O[123]$")
        message(FATAL_ERROR "SMSGG_OPTIMIZATION must be O1, O2 or O3")
    endif()
    set(_gen "${CMAKE_CURRENT_SOURCE_DIR}/generated")
    set(_sources "${_gen}/${_prefix}_full.c" "${_gen}/${_prefix}_dispatch.c" "${_gen}/${_prefix}_layout.c")
    if(SMSGG_REGENERATE)
        if(NOT EXISTS "${SMSGG_ROM}")
            message(FATAL_ERROR "Set SMSGG_ROM to your supported extracted cartridge")
        endif()
        if(NOT TARGET SmsRecomp)
            add_subdirectory("${_engine}/recompiler" "${CMAKE_BINARY_DIR}/sms-recompiler")
        endif()
        set(_deps "${SMSGG_ROM}" "${_config}")
        if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/dispatch_manifest.txt")
            list(APPEND _deps "${CMAKE_CURRENT_SOURCE_DIR}/dispatch_manifest.txt")
        endif()
        add_custom_command(OUTPUT ${_sources}
            BYPRODUCTS "${_gen}/${_prefix}_funcs.h"
            COMMAND "$<TARGET_FILE:SmsRecomp>" "${SMSGG_ROM}" --game "${_config}"
            DEPENDS SmsRecomp ${_deps}
            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" VERBATIM)
    else()
        foreach(_source IN LISTS _sources)
            if(NOT EXISTS "${_source}")
                message(FATAL_ERROR "Missing generated source ${_source}; enable SMSGG_REGENERATE")
            endif()
        endforeach()
    endif()
    if(SMSGG_ENABLE_SDL)
        find_package(SDL2 CONFIG REQUIRED)
        set(RECOMP_UI_ENABLE_MODS ON CACHE BOOL "" FORCE)
        include("${_engine}/external/recomp-ui/recomp_ui.cmake")
    endif()
    if(NOT TARGET smsgg_runtime)
        enable_language(CXX)
        set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
        set(SEGA_PSG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
        set(RECOMP_INPUT_BUILD_TESTS OFF CACHE BOOL "" FORCE)
        set(RECOMP_AUDIO_BUILD_TESTS OFF CACHE BOOL "" FORCE)
        foreach(core sega-psg-core recomp-mod-core recomp-audio-core recomp-input-core recomp-diagnostics-core recomp-persistence-core)
            add_subdirectory("${_engine}/external/${core}" "${CMAKE_BINARY_DIR}/shared/${core}")
        endforeach()
        add_library(smsgg_runtime STATIC
            "${_engine}/runner/main.c" "${_engine}/runner/glue.c"
            "${_engine}/runner/services.c" "${_engine}/runner/launcher.c"
            "${_engine}/runner/content_mods.cpp" "${_engine}/recompiler/src/toml.c"
            "${_engine}/runner/coverage_route.c" "${_engine}/runner/video/sms_vdp.c"
            "${_engine}/runner/audio/sn76489.c" "${_engine}/runner/external/superzazu/z80.c")
        target_compile_features(smsgg_runtime PUBLIC c_std_11)
        target_compile_definitions(smsgg_runtime PRIVATE SMSGG_HAVE_GAME_LAYOUT SMS_NATIVE_HOOKS SMS_NATIVE_DISPATCH SMS_NATIVE_EVENTS SMS_NATIVE_SPANS)
        target_include_directories(smsgg_runtime PUBLIC "${_engine}/runner" "${_engine}/runner/include"
            "${_engine}/recompiler/src"
            "${_engine}/external/recomp-presentation-core/include")
        target_link_libraries(smsgg_runtime PUBLIC sega-psg::core recomp-mod-core::core recomp-audio::core recomp-input::core recomp-diagnostics-core::core recomp-persistence-core::core)
        target_compile_options(smsgg_runtime PRIVATE "$<$<C_COMPILER_ID:GNU,Clang,AppleClang>:-${SMSGG_OPTIMIZATION}>")
        if(SMSGG_ENABLE_SDL)
            target_sources(smsgg_runtime PRIVATE "${_engine}/runner/host_sdl.c"
                "${_engine}/external/recomp-presentation-core/src/sdl2.c")
            target_compile_definitions(smsgg_runtime PUBLIC SMS_HAVE_SDL)
            target_link_libraries(smsgg_runtime PUBLIC SDL2::SDL2)
            if(SMSGG_ENABLE_GPU AND NOT SMSGG_REFERENCE_VDP)
                target_sources(smsgg_runtime PRIVATE "${_engine}/runner/host_gl.c")
                target_compile_definitions(smsgg_runtime PUBLIC SMS_GPU)
            endif()
            recomp_target_launcher_ui(smsgg_runtime CONSOLE smsgg)
        endif()
    endif()
    add_executable(${TARGET} ${_sources})
    target_link_libraries(${TARGET} PRIVATE smsgg_runtime)
    if(SMSGG_ENABLE_SDL)
        _recomp_ui_utf8_manifest(${TARGET})
        recomp_stage_launcher_assets(${TARGET} CONSOLE smsgg)
        if(WIN32)
            add_custom_command(TARGET ${TARGET} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL2::SDL2>" "$<TARGET_FILE_DIR:${TARGET}>" VERBATIM)
        endif()
    endif()
    target_compile_features(${TARGET} PRIVATE c_std_11)
    target_compile_definitions(${TARGET} PRIVATE SMSGG_HAVE_GAME_LAYOUT)
    target_compile_options(${TARGET} PRIVATE "$<$<C_COMPILER_ID:GNU,Clang,AppleClang>:-${SMSGG_OPTIMIZATION}>")
    if(SMSGG_NATIVE_EXECUTION)
        target_compile_definitions(${TARGET} PRIVATE SMS_NATIVE_HOOKS SMS_NATIVE_DISPATCH SMS_NATIVE_EVENTS SMS_NATIVE_SPANS)
    else()
        target_compile_definitions(${TARGET} PRIVATE SMS_PSG_REFERENCE)
    endif()
    if(SMSGG_REFERENCE_VDP)
        target_compile_definitions(${TARGET} PRIVATE SMS_VDP_REFERENCE)
    endif()
    target_include_directories(${TARGET} PRIVATE "${_engine}/runner" "${_engine}/runner/include" "${_gen}")
endfunction()
