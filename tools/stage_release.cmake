cmake_minimum_required(VERSION 3.20)
foreach(name ENGINE BUILD STAGE EXE TOOLCHAIN)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "Missing ${name}")
    endif()
endforeach()
foreach(name ENGINE BUILD STAGE TOOLCHAIN)
    file(TO_CMAKE_PATH "${${name}}" converted)
    set(${name} "${converted}")
endforeach()
# Consume the UI provider's authoritative selection, never copy another
# console's artwork or guess a list of font/image filenames.
set(RUI_ASSETS "${ENGINE}/external/recomp-ui/assets")
include("${ENGINE}/external/recomp-ui/cmake/recomp_ui_assets.cmake")
_recomp_ui_resolve_console_assets(console_assets smsgg)
_recomp_ui_resolve_console_optional_assets(optional_assets smsgg)
foreach(asset IN LISTS _RUI_COMMON_FONT_ASSETS _RUI_COMMON_IMG_ASSETS console_assets optional_assets)
    get_filename_component(name "${asset}" NAME)
    if(asset IN_LIST _RUI_COMMON_FONT_ASSETS)
        set(relative "assets/fonts/${name}")
    else()
        set(relative "assets/img/${name}")
    endif()
    if(NOT EXISTS "${BUILD}/${relative}")
        message(FATAL_ERROR "Missing built launcher asset: ${relative}")
    endif()
    file(SHA256 "${asset}" provider_hash)
    file(SHA256 "${BUILD}/${relative}" built_hash)
    if(NOT provider_hash STREQUAL built_hash)
        message(FATAL_ERROR "Built launcher asset differs from pinned UI: ${relative}")
    endif()
    get_filename_component(directory "${STAGE}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY "${BUILD}/${relative}" DESTINATION "${directory}")
endforeach()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${TOOLCHAIN}/bin/objdump.exe")
execute_process(COMMAND "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}" -f "${BUILD}/${EXE}"
                RESULT_VARIABLE result OUTPUT_VARIABLE architecture)
if(NOT result EQUAL 0 OR NOT architecture MATCHES "pei-x86-64")
    message(FATAL_ERROR "Game runtime is not a readable x64 PE image")
endif()
set(os_excludes "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${BUILD}/${EXE}"
    DIRECTORIES "${BUILD}" "${TOOLCHAIN}/bin"
    PRE_EXCLUDE_REGEXES ${os_excludes}
    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/[Ss][Yy][Ss][Tt][Ee][Mm]32/.*"
    RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
    CONFLICTING_DEPENDENCIES_PREFIX conflicts)
if(unresolved OR conflicts_FILENAMES)
    message(FATAL_ERROR "Incomplete runtime closure: ${unresolved}; conflicting ${conflicts_FILENAMES}")
endif()
file(COPY "${BUILD}/${EXE}" DESTINATION "${STAGE}")
set(runtime_names)
function(is_system_library path out)
    file(TO_CMAKE_PATH "${path}" normalized)
    file(TO_CMAKE_PATH "$ENV{SystemRoot}/System32" os_root)
    string(TOLOWER "${normalized}" normalized)
    string(TOLOWER "${os_root}" os_root)
    cmake_path(IS_PREFIX os_root "${normalized}" NORMALIZE system)
    set(${out} "${system}" PARENT_SCOPE)
endfunction()
foreach(dependency IN LISTS resolved)
    is_system_library("${dependency}" system)
    if(system)
        continue()
    endif()
    get_filename_component(name "${dependency}" NAME)
    # Require x64 binaries and reject a dependency collision before staging.
    execute_process(COMMAND "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}" -f "${dependency}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE architecture)
    if(NOT result EQUAL 0 OR NOT architecture MATCHES "pei-x86-64")
        message(FATAL_ERROR "Runtime is not a readable x64 PE image: ${dependency}")
    endif()
    file(COPY "${dependency}" DESTINATION "${STAGE}")
    list(APPEND runtime_names "${name}")
endforeach()
list(JOIN runtime_names "\n" runtime_text)
file(WRITE "${STAGE}/runtime-dependencies.txt" "${runtime_text}\n")
# Re-scan the actual stage: non-OS imports must resolve to the staged file,
# independent of any compiler DLLs which happen to be on the developer PATH.
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${STAGE}/${EXE}"
    DIRECTORIES "${STAGE}" PRE_EXCLUDE_REGEXES ${os_excludes}
    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/[Ss][Yy][Ss][Tt][Ee][Mm]32/.*"
    RESOLVED_DEPENDENCIES_VAR staged UNRESOLVED_DEPENDENCIES_VAR missing)
if(missing)
    message(FATAL_ERROR "Staged runtime has missing dependencies: ${missing}")
endif()
foreach(dependency IN LISTS staged)
    is_system_library("${dependency}" system)
    if(system)
        continue()
    endif()
    file(TO_CMAKE_PATH "${dependency}" dependency)
    get_filename_component(directory "${dependency}" DIRECTORY)
    cmake_path(NORMAL_PATH directory)
    cmake_path(NORMAL_PATH STAGE OUTPUT_VARIABLE stage_path)
    if(NOT directory STREQUAL stage_path)
        message(FATAL_ERROR "Runtime dependency resolves outside stage: ${dependency}")
    endif()
endforeach()
